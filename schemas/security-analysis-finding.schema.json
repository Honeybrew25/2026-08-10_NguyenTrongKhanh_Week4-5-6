{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/security-analysis-finding.schema.json",
  "title": "Grounded Security Analysis Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "severity",
    "locations",
    "scanner_evidence",
    "explanation",
    "verification_steps",
    "remediation_steps",
    "confidence",
    "occurrence_count",
    "source_finding_ids",
    "knowledge_ids",
    "analysis_method"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational",
        "unknown"
      ]
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/location"}
    },
    "scanner_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "explanation": {"type": "string", "minLength": 1},
    "verification_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "remediation_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "occurrence_count": {"type": "integer", "minimum": 1},
    "source_finding_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "knowledge_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "analysis_method": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_or_url", "line", "method"],
      "properties": {
        "file_or_url": {"type": "string", "minLength": 1},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "method": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "tool",
        "rule_id",
        "source_file",
        "evidence"
      ],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "source_file": {"type": "string", "minLength": 1},
        "evidence": {"type": ["string", "null"]}
      }
    }
  }
}
