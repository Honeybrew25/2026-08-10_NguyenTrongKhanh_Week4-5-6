# Copy this file to .env and replace every placeholder.
# Generate values with a password manager or: python -c "import secrets; print(secrets.token_urlsafe(32))"
KEYCLOAK_ADMIN_USERNAME=replace-with-local-admin-name
KEYCLOAK_ADMIN_PASSWORD=replace-with-long-random-admin-password
AGENT_READER_CLIENT_SECRET=replace-with-long-random-reader-secret
AGENT_ADMIN_CLIENT_SECRET=replace-with-long-random-admin-secret
INTEGRATION_EXPIRED_CLIENT_SECRET=replace-with-long-random-expired-test-secret
INTEGRATION_WRONG_AUDIENCE_CLIENT_SECRET=replace-with-long-random-audience-test-secret
