{
  "schema": "schemas/safe-api-test-cases.schema.json",
  "schema_version": "1.0",
  "test_cases": [
    {
      "id": "long-string",
      "category": "long-string",
      "description": "A bounded 1024-character string that tests length handling without exhausting resources.",
      "payload": {
        "value": ""
      },
      "expected_status": 200
    },
    {
      "id": "special-characters",
      "category": "special-characters",
      "description": "Benign punctuation, whitespace and Unicode used to exercise encoding and validation.",
      "payload": {
        "value": "<tag>&\"'\\/\n\t[]{}!?@#$%^*() — tiếng Việt"
      },
      "expected_status": 200
    },
    {
      "id": "empty",
      "category": "empty",
      "description": "An explicitly empty value; GET requests ignore the payload object.",
      "payload": {
        "value": ""
      },
      "expected_status": 200
    },
    {
      "id": "wrong-type",
      "category": "wrong-type",
      "description": "A number where the staging validation endpoint requires a string.",
      "payload": {
        "value": 42
      },
      "expected_status": 422
    }
  ]
}
