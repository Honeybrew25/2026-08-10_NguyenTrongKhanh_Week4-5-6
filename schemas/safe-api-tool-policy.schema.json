{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/safe-api-tool-policy.schema.json",
  "title": "Safe API Tool Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "gateway_origin",
    "api_key",
    "allowed_request_headers",
    "limits",
    "endpoints"
  ],
  "properties": {
    "schema": {"const": "schemas/safe-api-tool-policy.schema.json"},
    "schema_version": {"const": "1.0"},
    "gateway_origin": {"const": "http://localhost:8080"},
    "api_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header_name", "environment_variable", "principal_id"],
      "properties": {
        "header_name": {"const": "x-api-key"},
        "environment_variable": {"const": "SAFE_API_TOOL_API_KEY"},
        "principal_id": {"const": "safe-api-tool"}
      }
    },
    "allowed_request_headers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests_per_minute",
        "timeout_seconds",
        "max_request_bytes",
        "max_response_bytes",
        "max_requested_headers",
        "max_header_value_bytes"
      ],
      "properties": {
        "requests_per_minute": {"type": "integer", "minimum": 1, "maximum": 10000},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
        "max_request_bytes": {"type": "integer", "minimum": 128, "maximum": 1048576},
        "max_response_bytes": {"type": "integer", "minimum": 128, "maximum": 1048576},
        "max_requested_headers": {"type": "integer", "minimum": 0, "maximum": 16},
        "max_header_value_bytes": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "method", "path", "allowed_test_case_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
          "method": {"enum": ["GET", "POST"]},
          "path": {"type": "string", "pattern": "^/api/test/[a-z0-9/-]+$"},
          "allowed_test_case_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"}
          }
        }
      }
    }
  }
}
