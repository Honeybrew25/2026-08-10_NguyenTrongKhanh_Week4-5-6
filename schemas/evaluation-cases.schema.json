{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/evaluation-cases.schema.json",
  "title": "Project Sentinel Curated Evaluation Cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "truth_unit", "cases"],
  "properties": {
    "schema": {"const": "schemas/evaluation-cases.schema.json"},
    "schema_version": {"const": "1.0"},
    "truth_unit": {"const": "expected_tool_rule_group_per_analysis_case"},
    "cases": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "category", "description", "input", "expected", "allowed_variance", "pass_rule"],
        "properties": {
          "id": {"type": "string", "pattern": "^eval-[0-9]{2}-[a-z0-9-]+$"},
          "kind": {"enum": ["sql-analysis", "xss-analysis", "duplicate-grouping", "severity-preservation", "empty-input", "invalid-input", "hallucination-trap", "prompt-injection", "redaction", "approval-policy"]},
          "category": {"enum": ["analysis_group", "behavioral"]},
          "description": {"type": "string", "minLength": 1},
          "input": {"type": "object"},
          "expected": {"type": "object"},
          "allowed_variance": {"type": "array", "items": {"type": "string"}},
          "pass_rule": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
