{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/safe-api-approval.schema.json",
  "title": "Safe API Approval Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "approval_id", "run_id", "proposal_id", "policy_sha256",
    "trusted_origin_id", "request_fingerprint", "decision", "timestamp",
    "expires_at", "used", "approver_id", "reason"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "approval_id": {"type": "string", "pattern": "^[a-f0-9-]{36}$"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "proposal_id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
    "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "trusted_origin_id": {"enum": ["host", "compose"]},
    "request_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision": {"enum": ["approve", "reject"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "used": {"type": "boolean"},
    "approver_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "reason": {"type": "string", "minLength": 1, "maxLength": 200}
  }
}
